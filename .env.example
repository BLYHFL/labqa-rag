# ===== LabQA-RAG 环境变量配置 =====
# 复制为 .env 并填入真实值:  cp .env.example .env

# ===== LLM 模式（二选一）=====
# 模式 1：本地 Ollama（推荐，免费）
LABQA_LLM_MODE=ollama
OLLAMA_LLM_MODEL=deepseek-r1:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# 模式 2：云端 API（DeepSeek / OpenAI 兼容）
# LABQA_LLM_MODE=cloud
# LABQA_LLM_API_KEY=sk-your-api-key-here
# LABQA_LLM_API_BASE=https://api.deepseek.com
# LABQA_LLM_MODEL=deepseek-chat
# LABQA_LLM_TEMPERATURE=0.3
# LABQA_LLM_MAX_TOKENS=800

# ===== 检索参数（可选）=====
# RETRIEVE_K=5          # 每路检索取多少条
# FUSION_K=5            # RRF 融合后最终返回条数
# RRF_K=60              # RRF 融合参数
# CHUNK_SIZE=500        # 文本分块大小
# CHUNK_OVERLAP=50      # 分块重叠大小

# ===== 飞书配置（长连接模式，无需公网IP）=====
# 1. 飞书开放平台 https://open.feishu.cn 创建企业自建应用
# 2. 添加「机器人」能力，开权限: im:message:send_as_bot, im:message:read
# 3. 事件订阅 → 选择「使用长连接接收事件」
# 4. python3 main.py feishu
# FEISHU_APP_ID=cli_xxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 调试 =====
# LABQA_DEBUG=false
