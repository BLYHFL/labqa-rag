# LabQA 环境变量配置
# 复制为 .env 并填入真实值:  cp .env.example .env

# ===== LLM 配置（必填）=====
LABQA_LLM_API_KEY=sk-your-api-key-here
LABQA_LLM_PROVIDER=deepseek
LABQA_LLM_API_BASE=https://api.deepseek.com
LABQA_LLM_MODEL=deepseek-chat
LABQA_LLM_TEMPERATURE=0.3
LABQA_LLM_MAX_TOKENS=800

# ===== 飞书配置（长连接模式，无需公网IP）=====
# 1. 飞书开放平台 https://open.feishu.cn 创建企业自建应用
# 2. 添加「机器人」能力
# 3. 开权限: im:message:send_as_bot, im:message:read
# 4. 拿到 App ID 和 App Secret 填到下面
# 5. 事件订阅 → 选择「使用长连接接收事件」→ 保存
# 6. python3 main.py feishu
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 服务配置 =====
LABQA_HOST=0.0.0.0
LABQA_PORT=8080
LABQA_DEBUG=false
